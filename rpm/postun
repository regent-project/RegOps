#!/bin/sh
set -e

# $1 is the number of packages of this name still installed after this one
# is removed. Tear down user, home and sudoers only on final removal.
if [ "$1" = "0" ]; then
    systemctl disable regops.service || true
    rm -f /etc/sudoers.d/regops
    rm -rf /home/regops
    if getent passwd regops > /dev/null; then
        userdel --force regops || true
    fi
    if getent group regops > /dev/null; then
        groupdel regops || true
    fi
fi

systemctl daemon-reload || true
